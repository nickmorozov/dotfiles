# =============================================================================
# Dotfiles .gitignore
# =============================================================================
# This file controls what gets tracked in the dotfiles repo.
# Since dotbot symlinks home/.* → ~/, anything in home/ appears in ~.
# Be deliberate about what lives here vs what's auto-generated.
# =============================================================================

# -----------------------------------------------------------------------------
# Build artifacts & caches
# -----------------------------------------------------------------------------
*.zwc
*.pyc
*.log
*.tsbuildinfo
**/tsconfig*.json
.DS_Store
desktop.ini
Thumbs.db
node_modules
bower_components
Brewfile.lock.json
.Trash
backup

# -----------------------------------------------------------------------------
# Home directories that exist on disk but shouldn't be tracked
# (dotbot globs home/.* — these are excluded to avoid pulling in huge dirs)
# -----------------------------------------------------------------------------
/home/Library
/home/Applications
/home/Desktop
/home/Documents
/home/Movies
/home/Music
/home/Pictures
/home/Projects
/home/Public
/home/Torrents
/home/iCloud*

# -----------------------------------------------------------------------------
# JetBrains IDE
# -----------------------------------------------------------------------------
.idea/
**/.idea/
/IlluminatedCloud/
/.illuminatedCloud/
.localdev/
/out/
target/

# -----------------------------------------------------------------------------
# Claude Code (keep settings and memory — ignore session/plugin data and secrets)
# -----------------------------------------------------------------------------
home/.claude/.env
home/.claude/mcp-needs-auth-cache.json
home/.claude/backups/
home/.claude/image-cache/
home/.claude/paste-cache/
home/.claude/plans/
home/.claude/tasks/*/.highwatermark
home/.claude/tasks/*/.lock
home/.claude/todos/
home/.claude/telemetry/
home/.claude/plugins/blocklist.json
home/.claude/plugins/config.json
home/.claude/plugins/installed_plugins.json
home/.claude/plugins/known_marketplaces.json
home/.claude/projects/**/subagents/
home/.claude/projects/**/tool-results/
home/.claude/projects/**/*.jsonl
home/.claude/projects/**/sessions-index.json
home/.claude/security_warnings_state_*

# -----------------------------------------------------------------------------
# Raycast (extensions are compiled JS, auto-updated — ~900 MB)
# -----------------------------------------------------------------------------
home/.config/raycast/extensions/

# -----------------------------------------------------------------------------
# Binaries installed by package managers — not tracked
# These get reinstalled via brew/pip/npm/cargo, not from this repo.
# -----------------------------------------------------------------------------
home/.local/bin/uv
home/.local/bin/uvx
home/.local/bin/lsp-*.jar
home/.local/bin/claude
home/.local/bin/env
home/.local/bin/env.fish
home/.local/bin/*.png

# -----------------------------------------------------------------------------
# App configs — auto-generated, not needed, or removed
# -----------------------------------------------------------------------------
home/.config/github-copilot/
home/.config/fish/
home/.config/StardewValley/
home/.config/qBittorrent/
home/.config/Autodesk/
home/.config/swiftpm/
home/.config/jgit/
home/.config/neovide/
home/.config/.android/

# Symlinks that shouldn't be tracked
home/.settings

# Secrets and credentials
home/.local/bin/.env
home/.sfdx/
home/.config/jetbrains/idea/options/illuminatedCloudSfdxCache.xml
home/.config/raycast/config.json
home/.ssh/id_rsa
home/.ssh/id_ed25519

# Salesforce dataloader (large Java app, install separately)
home/.local/share/dataloader/
