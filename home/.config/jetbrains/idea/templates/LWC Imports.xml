    <variable name="CLASS" expression="complete()" defaultValue="" alwaysStopAt="true" />
    <variable name="MEMBER" expression="complete()" defaultValue="" alwaysStopAt="true" />
    <variable name="ALIAS" expression="complete()" defaultValue="" alwaysStopAt="true" />
    <context />
  </template>
</templateSet>