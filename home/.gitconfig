[init]
  defaultBranch = main

[color]
  ui = auto

[color "diff"]
  meta = white bold
  frag = cyan bold
  old = red bold
  new = green bold

[core]
  editor = vim
  excludesfile = ~/.config/git/ignore
  attributesfile = ~/.gitattributes
  ignorecase = false
	pager = diff-so-fancy | less --tabs=4 -RF
	autocrlf = input

[push]
  default = current
  autoSetupRemote = true

[pull]

[protocol "file"]
  allow = always

[alias]
  # Pretty log
  l = log --all --graph --decorate --oneline
  ll = log --stat --abbrev-commit

  # Common operations
  amend = commit --amend
  undo = reset --mixed HEAD^
  sync = !git pull && git push

# URL shorthands
[url "git@github.com:"]
  pushInsteadOf = "https://github.com/" # Fetch HTTPS, push SSH
  insteadOf = "gh:"
  pushInsteadOf = "github:"
  pushInsteadOf = "git://github.com/" # From GIT to SSH
[url "git@gist.github.com:"]
  insteadOf = "gst:"
  pushInsteadOf = "gist:"
  pushInsteadOf = "git://gist.github.com/" # From GIT to SSH

# Add LFS commands
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

# Include local settings from .gitlocal
# Requires Git 1.7.10
# Setup:
#   git config -f ~/.gitlocal user.email "your@email.com"
#   git config -f ~/.gitlocal user.name "Name Lastname"
# Example .gitlocal:
# [user]
#   name = Nick Morozov
#   email = nickmorozov@gmail.com
[include]
  path = ~/.gitlocal
[user]
	email = neurodeep@gmail.com
	name = Nick Morozov
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[interactive]
	diffFilter = diff-so-fancy --patch
