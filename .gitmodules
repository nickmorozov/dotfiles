[submodule "dotbot"]
	path = dotbot
	url = https://github.com/anishathalye/dotbot
	ignore = dirty
[submodule "home/.config/iterm2/iTerm2-Color-Schemes"]
	path = home/.config/iterm2/iTerm2-Color-Schemes
	url = https://github.com/mbadolato/iTerm2-Color-Schemes.git
[submodule "home/.local/repos/focus-manager"]
	path = home/.local/repos/focus-manager
	url = https://github.com/nickmorozov/focus-manager.git
[submodule "home/.local/repos/osx-calendar-syncer"]
	path = home/.local/repos/osx-calendar-syncer
	url = https://github.com/nickmorozov/osx-calendar-syncer.git
[submodule "home/.config/nvim"]
	path = home/.config/nvim
	url = https://github.com/nickmorozov/NvChad.git
[submodule "home/.local/repos/sudo-askpass-security"]
	path = home/.local/repos/sudo-askpass-security
	url = https://github.com/nickmorozov/sudo-askpass-security.git
