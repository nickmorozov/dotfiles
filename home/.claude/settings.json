{
  "env": {
    "CLAUDE_CODE_SHELL": "/bin/bash",
    "GITHUB_PERSONAL_ACCESS_TOKEN": "REDACTED_TOKEN"
  },
  "permissions": {
    "allow": [
      "Bash(apkeep:*)",
      "Bash(brew:*)",
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(cp:*)",
      "Bash(dns-sd:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(ifconfig:*)",
      "Bash(ipconfig:*)",
      "Bash(log show:*)",
      "Bash(ls:*)",
      "Bash(mdfind:*)",
      "Bash(mv:*)",
      "Bash(nc:*)",
      "Bash(networksetup:*)",
      "Bash(nm:*)",
      "Bash(node:*)",
      "Bash(osascript:*)",
      "Bash(pgrep:*)",
      "Bash(pip install:*)",
      "Bash(pkill:*)",
      "Bash(plutil:*)",
      "Bash(python3:*)",
      "Bash(screencapture:*)",
      "Bash(sed:*)",
      "Bash(timeout:*)",
      "Bash(tshark:*)",
      "Bash(wc:*)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:apkpure.com)",
      "WebFetch(domain:developer.salesforce.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:ocaalliance.github.io)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:smithery.ai)",
      "WebFetch(domain:support.focusrite.com)",
      "WebSearch"
    ],
    "defaultMode": "default"
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); dir=$(echo \"$input\" | jq -r '.workspace.current_dir' | sed \"s|^$HOME|~|\"); usage=$(echo \"$input\" | jq '.context_window.current_usage'); if [ \"$usage\" != \"null\" ]; then current=$(echo \"$usage\" | jq '.input_tokens + .cache_creation_input_tokens + .cache_read_input_tokens'); size=$(echo \"$input\" | jq '.context_window.context_window_size'); pct=$((current * 100 / size)); printf '%s | %d%% context' \"$dir\" \"$pct\"; else printf '%s' \"$dir\"; fi"
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": true
  },
  "outputStyle": "Explanatory",
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true
  },
  "alwaysThinkingEnabled": true
}
