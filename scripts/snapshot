#!/usr/bin/env zsh

# Reverse of bootstrap: captures current machine state
# - Dumps Homebrew packages to Brewfile
# - Stores git repos under ~/Projects as a manifest

trap on_error SIGTERM

e='\033'
RESET="${e}[0m"
BOLD="${e}[1m"
CYAN="${e}[0;96m"
RED="${e}[0;91m"
GREEN="${e}[0;92m"

info()    { echo -e "${CYAN}${*}${RESET}" }
error()   { echo -e "${RED}${*}${RESET}" }
success() { echo -e "${GREEN}${*}${RESET}" }
finish()  { success "Done!"; echo; sleep 1 }

export DOTFILES=${DOTFILES:-"$HOME/.dotfiles"}
PROJECTS_DIR="$HOME/Projects"
REPOS_MANIFEST="$DOTFILES/scripts/repos.txt"

on_start() {
  info '           __        __   ____ _  __            '
  info '      ____/ /____   / /_ / __/(_)/ /___   _____ '
  info '     / __  // __ \ / __// /_ / // // _ \ / ___/ '
  info '  _ / /_/ // /_/ // /_ / __// // //  __/(__  )  '
  info ' (_)\__,_/ \____/ \__//_/  /_//_/ \___//____/   '
  info '                                                '
  info '              by @nickmorozov                   '
  info '                                                '
  info '  snapshot: capturing machine state             '
  info '                                                '
}

dump_brew() {
  if ! command -v brew > /dev/null 2>&1; then
    error "Homebrew not found, skipping Brewfile dump"
    return
  fi

  info "Dumping Homebrew packages..."
  brew bundle dump --global --formula --cask --tap --mas --force --quiet
  success "Brewfile saved to ~/.Brewfile"
  finish
}

dump_repos() {
  if [ ! -d "$PROJECTS_DIR" ]; then
    error "Projects directory not found at $PROJECTS_DIR"
    return
  fi

  info "Scanning for git repos under $PROJECTS_DIR..."

  # Clear existing manifest
  > "$REPOS_MANIFEST"

  # Find all git repos and record their relative path + remote URL
  find "$PROJECTS_DIR" -maxdepth 3 -name .git -type d 2>/dev/null | sort | while read gitdir; do
    local dir="${gitdir%/.git}"
    local rel="${dir#$PROJECTS_DIR/}"
    local url=$(git -C "$dir" remote get-url origin 2>/dev/null)

    if [ -n "$url" ]; then
      echo "${rel}	${url}" >> "$REPOS_MANIFEST"
      success "  + $rel"
    else
      info "  ~ $rel (no remote, skipped)"
    fi
  done

  local count=$(wc -l < "$REPOS_MANIFEST" | tr -d ' ')
  success "Saved $count repo(s) to scripts/repos.txt"
  finish
}

on_finish() {
  echo
  success "Snapshot complete!"
  info "Files updated:"
  info "  ~/.Brewfile          (Homebrew packages)"
  info "  scripts/repos.txt    (Project repositories)"
  echo
  info "Run 'git diff' in dotfiles to review changes."
  echo
}

on_error() {
  error "Something went wrong during snapshot!"
  exit 1
}

main() {
  on_start
  dump_brew
  dump_repos
  on_finish
}

main
