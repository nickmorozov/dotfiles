#!/usr/bin/env bash

# Empty the Trash using macOS native AppleScript (safer than sudo rm -rf)
# Also clears Apple System Logs to improve shell startup speed
# USAGE: emptytrash

osascript -e 'tell application "Finder" to empty trash'
sudo rm -rfv /private/var/log/asl/*.asl 2>/dev/null
echo "Trash emptied."
